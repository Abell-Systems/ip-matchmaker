# --- Gemini / Vertex AI (ADK model config) ---
GEMINI_MODEL=gemini-3.5-flash
GOOGLE_GENAI_USE_VERTEXAI=false
# Used when GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=your-gemini-api-key-here
# Used for Vertex AI mode, BigQuery, and Cloud Run deploys
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- BigQuery Patents Public Datasets ---
# Flip to false once real GCP credentials + BigQuery access exist (see docs/roadmap.md)
USE_MOCK_BIGQUERY=true

# --- Demand Signals Data Source ---
# Selector for open technology demand signals: mock | innoget (default: mock)
DEMAND_SOURCE=mock

# --- App ---
PORT=8080
LOG_LEVEL=info
