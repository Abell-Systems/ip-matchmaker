# --- Standard LLM Provider Trio ---
# Options: gemini (default), groq, openrouter, openai, anthropic
MODEL_PROVIDER=gemini
# Model identifier (defaults per provider if empty: e.g. gemini-3.5-flash, llama-3.3-70b-versatile)
MODEL_NAME=
# Unified API Key (automatically mapped to provider SDK key: GROQ_API_KEY, GOOGLE_API_KEY, etc.)
MODEL_KEY=your-api-key-here

# --- Gemini / Vertex AI (Cloud Run / Production) ---
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- BigQuery Patents Public Datasets ---
# Flip to false once real GCP credentials + BigQuery access exist
USE_MOCK_BIGQUERY=true
# Hard cap (bytes) per query against patents-public-data.patents.publications (multi-TB
# table, /api/landscape is public/unauthenticated) -- a breach falls back to mock, no cost.
BIGQUERY_MAX_BYTES_BILLED=1000000000
# How long a real BigQuery result is cached in-process before re-querying.
BIGQUERY_CACHE_TTL_SECONDS=3600

# --- Demand Signals Data Source ---
# Selector for open technology demand signals: mock | innoget (default: mock)
DEMAND_SOURCE=mock

# --- App ---
PORT=8080
LOG_LEVEL=info
