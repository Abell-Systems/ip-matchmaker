# --- Standard LLM Provider Trio ---
# Options: gemini (default), groq, openrouter, openai, anthropic
MODEL_PROVIDER=groq
# Model identifier (defaults per provider if empty: e.g. llama-3.3-70b-versatile, gemini-3.5-flash)
MODEL_NAME=qwen/qwen3.8-27b
# Unified API Key (automatically mapped to provider SDK key: GROQ_API_KEY, GOOGLE_API_KEY, etc.)
MODEL_KEY=your-api-key-here

# --- Gemini / Vertex AI (Cloud Run / Production) ---
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- BigQuery Patents Public Datasets ---
# Flip to false once real GCP credentials + BigQuery access exist
USE_MOCK_BIGQUERY=true

# --- Demand Signals Data Source ---
# Selector for open technology demand signals: mock | innoget (default: mock)
DEMAND_SOURCE=mock

# --- App ---
PORT=8080
LOG_LEVEL=info
